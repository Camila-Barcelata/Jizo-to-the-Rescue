--- !u!114 &238882765
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 238882763}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9128fbf389109b0468f49600a8d2c2d1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  baseSprites: []
  mouthSprites: []
  topOptionDialogue: []
  thingsPersonSays:
  - key: "Hello\u2026 My name is Lady Yanagiya. Please treat me kindly, I\u2019ve gone through so much\u2026 "
    value:
    - "\u201CLady\u201D? Are you of noble blood? "
    - 'What has transpired that you believe warrants my compassion? '
  - key: "Yes, my lord. My father is a wealthy aristocrat. Though that is not important here\u2026 "
    value:
    - Uhuh
    - Uhhuh
  - key: "It\u2019s quite the tale, my lord\u2026 I was at Kiyomizu. I had gone to pray to Kannon. When a handsome man approached me. "
    value:
    - "If you\u2019re so beautiful, why the lack of suitors?"
    - 'Who was the man? '
  - key: "Are you trying to say I\u2019m ugly? My advisor tells me I\u2019m beautiful all the time. That\u2019s all that matters, anyway. As I was saying\u2026 "
    value:
    - 'Why had you gone to pray? '
    - 'What did he say? '
  - key: "He was a bold man. He said he was unmarried\u2026 Complimented me\u2026 And asked for my hand in marriage. "
    value:
    - 'Why did you say you were a fool? '
    - 'Did you know him? '
  moralPoints: 0
