      baseSprite: {fileID: 0}
      mouthSprite: {fileID: 0}
  - key: Idiot
    value:
      character_text: "Don\u2019t blame me blame this idiotic system of yours."
      nodeID: Idiot
      answers:
      - answer_text: What is it with your hostility?
        nextID: skip
