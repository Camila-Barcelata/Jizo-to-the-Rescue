      mouthSprite: {fileID: 0}
  - key: skip
    value:
      character_text: Can we skip all these questions I can not say I have more patience, I am an important man!
      nodeID: skip
      answers: []
      CountsTowardsEnding: 0
      baseSprite: {fileID: 0}
      mouthSprite: {fileID: 0}
  - key: Random
    value:
      character_text: And yet the one judging me is some random. Look here I know he put you up to this, but he should give it up.
      nodeID: Random
      answers:
      - answer_text: I- What is the matter with you?
        nextID: Backer
