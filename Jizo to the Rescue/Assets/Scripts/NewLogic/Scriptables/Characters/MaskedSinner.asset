%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f395e524722d44617a6d4bfd8d66ee5c, type: 3}
  m_Name: MaskedSinner
  m_EditorClassIdentifier: Assembly-CSharp::CharacterDetailsInspector
  karmicMerit: 75
  Tengu: 0
  Destination: 1
  introLines:
  - character_text: Well, well, well...
    baseSprite: {fileID: -2685202389345621323, guid: 826dfebe57c5341fb94314da88fc5f54, type: 3}
    mouthSprite: {fileID: 0}
  finalLines:
  - character_text: "My lord... you\u2019ve heard everything I have to say. You know of my misdeeds. If you believe I am-cough-still deserving of damnation, do what you must."
    baseSprite: {fileID: 21300000, guid: 7dea8bdc66a774643be54315673e07bc, type: 3}
    mouthSprite: {fileID: 0}
  - character_text: I apologize, Bodhisattva, if my son gives you trouble for your decision. I have... cough... come to accept that your judgment is fair and just.
    baseSprite: {fileID: 21300000, guid: 7dea8bdc66a774643be54315673e07bc, type: 3}
    mouthSprite: {fileID: 0}
  hellLines:
  - character_text: "Ah... I see. If that is your final decision-cough-I suppose I can\u2019t do anything to change your mind."
    baseSprite: {fileID: 21300000, guid: 7dea8bdc66a774643be54315673e07bc, type: 3}
    mouthSprite: {fileID: 0}
  - character_text: "I understand why you\u2019re doing this. Hopefully we meet again under different circumstances, my lord."
    baseSprite: {fileID: 21300000, guid: 7dea8bdc66a774643be54315673e07bc, type: 3}
    mouthSprite: {fileID: 0}
  - character_text: "Tell my son I\u2019ll be okay for me, will you?"
    baseSprite: {fileID: 21300000, guid: 7dea8bdc66a774643be54315673e07bc, type: 3}
    mouthSprite: {fileID: 0}
  humanLines:
  - character_text: "R-cough-really, my lord? If that\u2019s your decision, I am be forever grateful. "
    baseSprite: {fileID: 21300000, guid: 7dea8bdc66a774643be54315673e07bc, type: 3}
    mouthSprite: {fileID: 0}
  - character_text: "You truly are a merciful Bodhisattva. I\u2019m sure my son will be pleased to know of your verdict. "
    baseSprite: {fileID: 21300000, guid: 7dea8bdc66a774643be54315673e07bc, type: 3}
    mouthSprite: {fileID: 0}
  - character_text: I apologize if your doing this results in any sort of punishment because of what I am... I know your mentor probably wanted me to stay in Hell.
    baseSprite: {fileID: 21300000, guid: 7dea8bdc66a774643be54315673e07bc, type: 3}
    mouthSprite: {fileID: 0}
  - character_text: But anyhow... I hope I get to meet you again, Jizo.
    baseSprite: {fileID: 21300000, guid: 7dea8bdc66a774643be54315673e07bc, type: 3}
    mouthSprite: {fileID: 0}
  heavenLines: []
  CharacterNodes:
  - key: aletter
    value:
      character_text: BODHISATTVA JIZO! In my hands is a letter.
      nodeID: aletter
      answers:
      - answer_text: Indeed there is...
        nextID: whatsinside
      - answer_text: "Can\u2019t you talk a little quieter? "
        nextID: sassyboy
      CountsTowardsEnding: 0
      baseSprite: {fileID: -2685202389345621323, guid: 826dfebe57c5341fb94314da88fc5f54, type: 3}
      mouthSprite: {fileID: 0}
  - key: whatsinside
    value:
      character_text: "Don\u2019t you want to know what\u2019s inside? In fact... shouldn\u2019t you already?"
      nodeID: whatsinside
      answers:
      - answer_text: Is it from me?
        nextID: youremember
      CountsTowardsEnding: 0
      baseSprite: {fileID: -2685202389345621323, guid: 826dfebe57c5341fb94314da88fc5f54, type: 3}
      mouthSprite: {fileID: 0}
  - key: sassyboy
    value:
      character_text: "Don\u2019t you tell me how to act! I\u2019m on my way to the Pure Land!"
      nodeID: sassyboy
      answers:
      - answer_text: What makes you think that...
        nextID: readit
      CountsTowardsEnding: 0
      baseSprite: {fileID: -2685202389345621323, guid: 826dfebe57c5341fb94314da88fc5f54, type: 3}
      mouthSprite: {fileID: 0}
  - key: youreremember
    value:
      character_text: ' Ah... it seems you remember! Indeed it is, o astute Bodhisattva! '
      nodeID: youremember
      answers:
      - answer_text: Just show me it already, sir.
        nextID: apologizing
      CountsTowardsEnding: 0
      baseSprite: {fileID: -2685202389345621323, guid: 826dfebe57c5341fb94314da88fc5f54, type: 3}
      mouthSprite: {fileID: 0}
  - key: readit
    value:
      character_text: "Well, I guess you\u2019ll have to read this letter to find out!"
      nodeID: readit
      answers:
      - answer_text: Just show me it already, sir.
        nextID: apologizing
      CountsTowardsEnding: 0
      baseSprite: {fileID: -2685202389345621323, guid: 826dfebe57c5341fb94314da88fc5f54, type: 3}
      mouthSprite: {fileID: 0}
  - key: apologizing
    value:
      character_text: "Very well. Don\u2019t start sobbing to me apologizing once you get to the end."
      nodeID: apologizing
      answers:
      - answer_text: '[Take the note]'
        nextID: thenote
      CountsTowardsEnding: 0
      baseSprite: {fileID: -2685202389345621323, guid: 826dfebe57c5341fb94314da88fc5f54, type: 3}
      mouthSprite: {fileID: 0}
  - key: thenote
    value:
      character_text: "(The man hands you the letter. Inside, a note from you to the Sinner\u2019s brother-in-law promising him safe passage into the Pure Land.)"
      nodeID: thenote
      answers:
      - answer_text: "Um... you understand this isn\u2019t addressed to you, right?"
        nextID: trumpets
      - answer_text: Wait a second... are you...
        nextID: humblebrag
      CountsTowardsEnding: 0
      baseSprite: {fileID: -2685202389345621323, guid: 826dfebe57c5341fb94314da88fc5f54, type: 3}
